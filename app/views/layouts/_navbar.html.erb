<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <%= link_to "VetClinic", root_path, class: "navbar-brand" %>

    <div class="navbar-nav">
      <%= link_to "Owners", owners_path, class: "nav-link" %>
      <%= link_to "Pets", pets_path, class: "nav-link" %>
      <%= link_to "Vets", vets_path, class: "nav-link" %>
      <%= link_to "Appointments", appointments_path, class: "nav-link" %>
    </div>

    <div class="d-flex ms-auto">
      <% if user_signed_in? %>
        <span class="navbar-text text-white me-3">
          <%= current_user.first_name %> <%= current_user.last_name %>
        </span>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                      class: "btn btn-link nav-link text-white p-0",
                      data: { turbo_confirm: "Are you sure?" } %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "nav-link text-white" %>
        <%= link_to "Sign up", new_user_registration_path, class: "nav-link text-white" %>
      <% end %>
    </div>
  </div>
</nav>